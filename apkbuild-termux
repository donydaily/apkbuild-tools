#!/usr/bin/env bash
set -e

# --- KONFIGURASI ENVIRONMENT TERMUX ---
export PREFIX="/data/data/com.termux/files/usr"
export ANDROID_HOME="$HOME/android-sdk"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"

# --- FUNGSI INSTALL DEPENDENSI TERMUX ---
setup_termux_env() {
    echo "[+] Memeriksa dependensi Termux..."
    
    MISSING_PKGS=""
    for pkg in openjdk-21 wget unzip git aapt aapt2 android-tools; do
        if ! command -v "$pkg" &> /dev/null && [ ! -f "$PREFIX/bin/$pkg" ]; then
            MISSING_PKGS="$MISSING_PKGS $pkg"
        fi
    done

    if [ -n "$MISSING_PKGS" ]; then
        echo "[!] Mengunduh paket pendukung Termux:$MISSING_PKGS..."
        pkg update -y
        pkg upgrade -y
        # shellcheck disable=SC2086
        pkg install termux-api -y
        pkg install -y $MISSING_PKGS
    fi

    export JAVA_HOME="$PREFIX/lib/jvm/java-21-openjdk"
}

# --- FUNGSI PATCH AAPT2 UNTUK TERMUX ---
patch_aapt2_termux() {
    AAPT2_SYS="$PREFIX/bin/aapt2"
    if [ -d "$HOME/.gradle/caches" ]; then
        # Cari semua berkas bernama 'aapt2' di dalam folder cache Gradle
        find "$HOME/.gradle/caches/" -name "aapt2" -type f 2>/dev/null | while read -r biner; do
            # Cek jika berkas bukan merupakan wrapper shell script
            if ! head -n 1 "$biner" 2>/dev/null | grep -q "#!/bin/sh"; then
                rm -f "$biner"
                cat << EOF > "$biner"
#!/bin/sh
exec $AAPT2_SYS "\$@"
EOF
                chmod +x "$biner"
            fi
        done
    fi
}

# --- AUTO INSTALL APK ---
auto_install_apk() {
    local apk_path="$1"
    
    if [ -f "$apk_path" ]; then
        echo "[+] Menginstall APK via ADB..."
        
        # Pastikan server ADB berjalan dan terhubung
        if adb devices | grep -q "device$"; then
            adb install -r "$apk_path"
            echo "[+] Instalasi Berhasil!"
        else
            echo "[!] ADB tidak terhubung. Sambungkan ADB via Wireless Debugging terlebih dahulu."
            echo "[!] File APK tersimpan di: $apk_path"
        fi
    else
        echo "[!] File APK tidak ditemukan di: $apk_path"
    fi
}

# --- FUNGSI CEK & INSTALL ANDROID SDK DI TERMUX ---
check_sdk() {
    setup_termux_env

    if [ ! -d "$ANDROID_HOME/cmdline-tools/latest" ]; then
        echo "[!] Android Command-line Tools belum terinstall."
        echo "[-] Mengunduh Command-line Tools untuk Termux..."
        mkdir -p "$ANDROID_HOME/cmdline-tools"
        mkdir -p "$PREFIX/tmp"
        wget -q --show-progress https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O "$PREFIX/tmp/cmdline-tools.zip"
        unzip -q "$PREFIX/tmp/cmdline-tools.zip" -d "$ANDROID_HOME/cmdline-tools"
        mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"
        rm "$PREFIX/tmp/cmdline-tools.zip"
    fi

    echo "[+] Menyetujui lisensi Android SDK..."
    yes | sdkmanager --licenses > /dev/null 2>&1 || true

    echo "[+] Memastikan Platform SDK (API 33-37) & Build-Tools terpasang..."
    sdkmanager "platform-tools" \
               "build-tools;34.0.0" \
               "platforms;android-33" \
               "platforms;android-34" \
               "platforms;android-35" \
               "platforms;android-36" \
               "platforms;android-37.0" > /dev/null 2>&1
}

# --- FUNGSI GENERATE TEMPLATE PROYEK ---
init_project() {
    echo -n "Masukkan Nama Aplikasi (default: MyAndroidApp): "
    read -r APP_NAME
    if [ -z "$APP_NAME" ]; then
        APP_NAME="MyAndroidApp"
    fi

    FOLDER_NAME=$(echo "$APP_NAME" | sed 's/[^a-zA-Z0-9_-]/_/g')

    if [ -d "$FOLDER_NAME" ]; then
        echo "[!] Folder '$FOLDER_NAME' sudah ada! Silakan gunakan nama lain."
        exit 1
    fi

    echo -n "Masukkan Package Name (contoh: com.namamu.myapp): "
    read -r PACKAGE_NAME
    if [ -z "$PACKAGE_NAME" ]; then
        PACKAGE_NAME="com.example.app"
        echo "[!] Package name kosong. Menggunakan default: $PACKAGE_NAME"
    fi

    echo "[+] Membuat direktori proyek: ./$FOLDER_NAME"
    mkdir -p "$FOLDER_NAME"
    cd "$FOLDER_NAME"

    PKG_PATH=$(echo "$PACKAGE_NAME" | tr '.' '/')

    echo "[+] Membuat struktur folder proyek..."
    mkdir -p "app/src/main/java/$PKG_PATH"
    mkdir -p app/src/main/res/layout
    mkdir -p app/src/main/res/values
    mkdir -p app/src/main/res/drawable
    mkdir -p app/src/main/res/mipmap-anydpi-v26

    echo "[+] Membuat debug.keystore lokal..."
    keytool -genkey -v \
        -keystore app/debug.keystore \
        -storepass android \
        -alias androiddebugkey \
        -keypass android \
        -keyalg RSA \
        -keysize 2048 \
        -validity 10000 \
        -dname "CN=Android Debug,O=Android,C=US" > /dev/null 2>&1

    cat << 'EOF' > build.gradle.kts
plugins {
    id("com.android.application") version "8.7.0" apply false
    id("org.jetbrains.kotlin.android") version "2.0.20" apply false
}
EOF

    cat << EOF > settings.gradle.kts
pluginManagement {
    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
    }
}
dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories {
        google()
        mavenCentral()
    }
}
rootProject.name = "$APP_NAME"
include(":app")
EOF

    cat << 'EOF' > gradle.properties
