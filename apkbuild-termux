# --- EXECUTION LOGIC ---
case "$1" in
    init)
        check_sdk
        init_project
        ;;
    debug)
        patch_aapt2_termux
        echo "[+] Memulai proses build APK Debug..."
        if ./gradlew assembleDebug --no-configuration-cache -Pandroid.aapt2.override=$PREFIX/bin/aapt2; then
            APK_PATH="app/build/outputs/apk/debug/app-debug.apk"
            echo "[+] Build Berhasil! APK tersimpan di: $APK_PATH"
            
            # Panggil auto-install di sini
            auto_install_apk "$APK_PATH"
        fi
        ;;
    release)
        patch_aapt2_termux
        echo "[+] Memulai proses build APK Release..."
        if ./gradlew assembleRelease --no-configuration-cache -Pandroid.aapt2.override=$PREFIX/bin/aapt2; then
            APK_PATH="app/build/outputs/apk/release/app-release.apk"
            echo "[+] Build Berhasil! APK tersimpan di: $APK_PATH"
            
            # Panggil auto-install di sini
            auto_install_apk "$APK_PATH"
        fi
        ;;
    clean)
        ./gradlew clean
        ;;
    stop)
        ./gradlew --stop
        ;;
    *)
        echo "Cara penggunaan:"
        echo " apkbuild init - Inisialisasi proyek Android baru"
        echo " apkbuild debug - Build APK versi Debug"
        echo " apkbuild release - Build APK versi Release"
        echo " apkbuild clean - Bersihkan cache & file build"
        exit 0
        ;;
esac
